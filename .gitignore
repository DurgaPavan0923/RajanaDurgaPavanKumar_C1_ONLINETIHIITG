# ==============================================================================
# AquaGuard AI - Version Control Ignore Protocol
# ==============================================================================

# Python Bytecode & Optimization Caches
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/

# Virtual Environment
.venv/
venv/
env/
ENV/

# Testing, Linting & Coverage Outputs
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/
.coverage
.coverage.*
coverage.xml
htmlcov/

# IDE & OS Ephemeral Files
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Dynamic Pipeline Intermediate Data (Preserve Structure via .gitkeep)
data/interim/*
!data/interim/.gitkeep
data/02_processed/*
!data/02_processed/.gitkeep
data/03_features/*
!data/03_features/.gitkeep
data/04_lockbox/*
!data/04_lockbox/.gitkeep

# Temporary Logs & Execution Artifacts
*.log
outputs/logs/*.log
artifacts/
*.tmp
*.bak

# Deprecated Migration & Reorganization Scripts
organize.sh
organize.ps1
restructure.sh
restructure.ps1

# Secrets, Tokens & Local Environment Variables
.env
.env.*
!.env.example
*.pem
*.key
*.token
*.pfx
