# ==============================================================================
# AquaGuard AI - Version Control Ignore Protocol
# ==============================================================================

# Python Bytecode & Optimization Caches
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/

# Virtual Environment
.venv/
venv/
env/
ENV/

# Testing & Coverage Outputs
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/

# IDE & OS Ephemeral Files
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Dynamic Pipeline Intermediate Data (Preserve Structure via .gitkeep)
data/raw/*
!data/raw/.gitkeep
data/interim/*
!data/interim/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/02_processed/*
!data/02_processed/.gitkeep
data/03_features/*
!data/03_features/.gitkeep
data/04_lockbox/*
!data/04_lockbox/.gitkeep
*.parquet

# Intermediate Model Artifacts (Keep Only Production Frozen Model)
artifacts/**/*.joblib

# Temporary Logs (Allow outputs/logs/)
*.log
!outputs/logs/*.log

# Secrets, Tokens & Local Environment Variables
.env
.env.*
*.pem
*.key
*.token
*.pfx
