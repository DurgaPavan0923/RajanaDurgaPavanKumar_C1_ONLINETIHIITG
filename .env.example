# ==============================================================================
# AquaGuard AI - Environment Configuration Example
# Copy to .env for local runtime overrides. Do not commit secrets to git.
# ==============================================================================

# Server Hosting Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=production

# Logging & Telemetry Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Optional API Security Key (Leave blank for public demo mode)
API_SECURITY_TOKEN=

# Model Artifact Path Overrides (Defaults to models/production/)
MODEL_PATH=models/production/water_potability_pipeline_v1.joblib
FORECASTER_PATH=models/production/underwater_forecaster_v1.joblib
